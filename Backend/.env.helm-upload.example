# Copy to .env.helm-upload (ignored by Git). Never commit real credentials.
HELM_UPLOAD_ENABLED=true
HELM_REPOSITORY_URL=http://10.160.101.73
HELM_UPLOAD_URL=http://10.160.101.73/api/charts
HELM_UPLOAD_TOKEN=replace-with-repository-token
HELM_UPLOAD_ADMIN_USER=chart-admin
# Keep the generated hash in single quotes so Compose preserves its $ separators.
HELM_UPLOAD_ADMIN_PASSWORD_HASH='replace-with-generated-werkzeug-hash'
HELM_UPLOAD_CONNECT_TIMEOUT_SECONDS=10
HELM_UPLOAD_TIMEOUT_SECONDS=300
HELM_UPLOAD_MAX_BYTES=104857600
